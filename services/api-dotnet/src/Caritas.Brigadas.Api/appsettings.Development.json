{
  "Authentication": {
    "Mode": "Development",
    "RequireHttpsMetadata": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Security": {
    "RequireHttps": true,
    "EnableDetailedErrors": true,
    "RateLimiting": {
      "Enabled": false,
      "PermitLimit": 300,
      "WindowMinutes": 1,
      "QueueLimit": 0
    }
  },
  "Features": {
    "EnableSwaggerInDevelopment": true,
    "EnableAiGateway": false,
    "EnableCryptoAuditLab": false,
    "EnableAnalytics": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}

