{
  "Application": {
    "Name": "Caritas Brigadas de Salud API",
    "ServiceCode": "caritas-brigadas-api",
    "Version": "0.1.0"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://brigadas.caritas.example.org"
    ]
  },
  "Security": {
    "RequireHttps": true,
    "EnableDetailedErrors": false,
    "RateLimiting": {
      "Enabled": true,
      "PermitLimit": 100,
      "WindowMinutes": 1,
      "QueueLimit": 0
    },
    "MaxRequestBodyBytes": 5242880
  },
  "Authentication": {
    "Mode": "JwtBearer",
    "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "Audience": "api://<api-client-id-or-application-id-uri>",
    "RequireHttpsMetadata": true,
    "ValidIssuer": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "ValidAudiences": [
      "api://<api-client-id-or-application-id-uri>"
    ]
  },
  "Features": {
    "EnableSwaggerInDevelopment": false,
    "EnableAiGateway": false,
    "EnableCryptoAuditLab": false,
    "EnableAnalytics": false
  },
  "ConnectionStrings": {
    "SqlServer": "Server=tcp:<server-name>.database.windows.net,1433;Initial Catalog=CaritasBrigadas;Encrypt=True;TrustServerCertificate=False;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "brigadas.caritas.example.org"
}
